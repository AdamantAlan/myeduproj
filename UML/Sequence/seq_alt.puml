@startuml
actor Клиент
participant Система
participant Банк

Клиент -> Система : Оплатить заказ
Система -> Банк : Провести платеж

alt Оплата успешна
    Банк --> Система : OK
    Система --> Клиент : Заказ оплачен
else Недостаточно средств
    Банк --> Система : Ошибка
    Система --> Клиент : Недостаточно средств
else Банк недоступен
    Банк --> Система : Timeout
    Система --> Клиент : Попробуйте позже
end

@enduml