@startuml
title Оформление заказа в интернет-магазине

' ==========================================
' Пользователь
' ==========================================

|Покупатель|

start

:Открыть корзину;

if (Корзина пустая?) then (Да)
    :Показать сообщение\n"Корзина пуста";
    stop
else (Нет)
endif

:Нажать "Оформить заказ";

' ==========================================
' Система магазина
' ==========================================

|Интернет-магазин|

:Получить данные корзины;

note right
  Проверяем:
  - наличие товаров
  - актуальность цен
  - доступность доставки
end note

:Проверить товары;

' Decision
if (Все товары доступны?) then (Да)

else (Нет)

    :Показать недоступные товары;

    |Покупатель|

    if (Удалить недоступные товары?) then (Да)
        :Удалить товары из корзины;
    else (Нет)
        :Отменить оформление;
        stop
    endif

endif


' ==========================================
' Ввод данных
' ==========================================

|Покупатель|

repeat
    :Ввести адрес доставки;

    |Интернет-магазин|
    :Проверить адрес;

    if (Адрес корректный?) then (Да)
        :Адрес подтверждён;
    else (Нет)
        :Показать ошибку адреса;
    endif

repeat while (Адрес некорректный?) is (Да)
->Нет;


' ==========================================
' Параллельные действия — FORK / JOIN
' ==========================================

|Интернет-магазин|

fork

    :Рассчитать стоимость доставки;

    |Сервис доставки|
    :Получить тариф доставки;
    :Вернуть стоимость;

fork again

    |Интернет-магазин|
    :Рассчитать скидку;

    |Сервис лояльности|
    :Получить скидку клиента;
    :Вернуть размер скидки;

fork again

    |Интернет-магазин|
    :Проверить остатки;

    |Склад|
    :Проверить наличие товаров;
    :Зарезервировать товары;

end fork


' ==========================================
' После JOIN
' ==========================================

|Интернет-магазин|

:Рассчитать итоговую стоимость;

|Покупатель|

:Выбрать способ оплаты;

if (Способ оплаты?) then (Карта)

    |Интернет-магазин|
    :Создать платёж;

    |Платёжный сервис|
    :Провести оплату;

    if (Оплата успешна?) then (Да)

        :Отправить подтверждение оплаты;

    else (Нет)

        :Отправить отказ в оплате;

        |Интернет-магазин|
        :Получить отказ;

        |Покупатель|

        if (Попробовать ещё раз?) then (Да)
            :Выбрать другую карту;

            |Платёжный сервис|
            :Повторить оплату;

            if (Оплата успешна?) then (Да)
                :Отправить подтверждение;
            else (Нет)
                |Интернет-магазин|
                :Снять резерв товаров;
                stop
            endif

        else (Нет)

            |Интернет-магазин|
            :Снять резерв товаров;
            stop

        endif

    endif

else (При получении)

    |Интернет-магазин|
    :Установить статус\n"Оплата при получении";

endif


' ==========================================
' Создание заказа
' ==========================================

|Интернет-магазин|

:Создать заказ;

note right
  Статус:
  CREATED
end note

:Сохранить заказ в БД;


' ==========================================
' Асинхронное событие
' ==========================================

:Отправить событие\n<<send signal>>\nOrderCreated;


' ==========================================
' Параллельная реакция систем
' ==========================================

fork

    |Склад|

    :Получить событие\n<<accept event>>\nOrderCreated;

    :Начать комплектацию заказа;

    :Собрать заказ;

fork again

    |Сервис уведомлений|

    :Получить событие\n<<accept event>>\nOrderCreated;

    :Отправить Email;

    :Отправить Push;

fork again

    |Аналитика|

    :Получить событие\n<<accept event>>\nOrderCreated;

    :Записать событие покупки;

end fork


' ==========================================
' Доставка
' ==========================================

|Склад|

:Передать заказ в доставку;

|Сервис доставки|

:Принять заказ;

:Назначить курьера;

:Отправить событие\nOrderOutForDelivery;


|Интернет-магазин|

:Получить событие\nOrderOutForDelivery;

:Изменить статус заказа\nна "В доставке";


' ==========================================
' Ожидание внешнего события
' ==========================================

|Сервис доставки|

:Ожидать результат доставки\n<<accept event>>;

if (Заказ доставлен?) then (Да)

    :Отправить событие\nOrderDelivered;

    |Интернет-магазин|

    :Получить OrderDelivered;

    :Изменить статус\nна "Доставлен";

    |Покупатель|

    :Получить уведомление\nо доставке;

else (Нет)

    :Зафиксировать неудачную доставку;

    if (Повторить доставку?) then (Да)

        :Назначить новую дату;
        :Повторить доставку;

    else (Нет)

        :Вернуть заказ на склад;

        |Интернет-магазин|

        :Изменить статус\nна "Возврат";

    endif

endif


' ==========================================
' Завершение Activity
' ==========================================

|Интернет-магазин|

:Закрыть процесс обработки заказа;

stop

@enduml